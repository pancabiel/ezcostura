{
  "name": "ezcostura-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for ezcostura — Firefox via Playwright",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test --project=firefox",
    "test:smoke": "playwright test --project=firefox tests/smoke.spec.ts",
    "test:full": "playwright test --project=firefox tests/full-flow.spec.ts",
    "test:headed": "playwright test --project=firefox --headed",
    "test:debug": "PWDEBUG=1 playwright test --project=firefox",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
