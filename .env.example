# ezcostura — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---- Spring profile -----------------------------------------------------
# Use `prod` in any non-local environment. The `prod` profile refuses to
# start unless every secret below is set.
SPRING_PROFILES_ACTIVE=prod

# ---- Database -----------------------------------------------------------
DB_NAME=ezcostura
DB_USER=ezcostura
# Generate with: openssl rand -base64 24
DB_PASSWORD=replace-me-with-a-strong-random-password

# ---- JWT signing key ----------------------------------------------------
# At least 32 bytes of entropy. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-output-of-openssl-rand-base64-48

# Optional TTLs (seconds). Defaults: 1h access, 14d refresh.
# JWT_ACCESS_TTL_SECONDS=3600
# JWT_REFRESH_TTL_SECONDS=1209600

# ---- CORS ---------------------------------------------------------------
# Comma-separated list of explicit frontend origins. No wildcards.
EZCOSTURA_CORS_ORIGINS=https://app.example.com

# ---- Tenants ------------------------------------------------------------
# Initial tenant created on first boot. Add more via the admin path later.
INITIAL_TENANT=demo

# ---- Sentry (error monitoring) ------------------------------------------
# Create a free project at https://sentry.io/ -> Settings -> Client Keys (DSN).
# Leave SENTRY_DSN empty to disable error reporting (no events leave the box).
# Stack traces and tenant IDs are sent; request bodies, headers, and cookies
# are scrubbed in SentryConfig before upload.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Set to true once to verify the integration; revert to false afterwards.
SENTRY_DEBUG=false
